# Copy to .env and fill in. Never commit .env. Never hardcode secrets.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/furniture-studio
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Phase 4 — vision AI (analysis only; never used for 3D generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Storage for uploaded images / exported models (Phase 4/7)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
